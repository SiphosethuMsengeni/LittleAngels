# Copy this file to .env and set your own values before deployment.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PIN=choose-your-own-admin-pin
# WhatsApp number in international format, digits only. Example South Africa: 27821234567
WHATSAPP_NUMBER=
STORAGE_BACKEND=local
# For Supabase hosting, set STORAGE_BACKEND=supabase and configure these in Render.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=little-angels-images
